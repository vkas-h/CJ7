{
    "data_dir": "data",
    "search_paths": ["~"],
    "blocked_paths":[
        "C:/Windows",
        "C:/Program Files",
        "C:/Program Files (x86)"
    ],
    "ignore":[
        "temp",
        "cache",
        "appdata",
        ".git",
        "node_modules",
        "__pycache__"
    ],
    "max_result":20,
    "app_registry": "data/apps.json",
    "history_file": "data/history.txt",
    "notes_file": "data/notes.txt",
    "jobs_file": "data/jobs.json",
    "log_file":"data/cj7.log",
    "session_folder" : "data/sessions",

    "llm": {
        "provider": "ollama",
        "model": "beam:cloud",
        "num_ctx": 32768
    },

    "wakeword": {
        "model_path": "models/hey_cj7.onnx",
        "threshold": 0.5,
        "cooldown": 2.0,
        "debug": true
    },

    "stt": {
        "engine": "phonon",
        "model": "phonon-2",
        "hotwords": ["CJ7"],
        "whisper_device": "cuda",
        "whisper_compute_type": "int8_float16"
    },

    "tts": {
        "device": "auto",
        "model_path": "models/tts/en_US-lessac-medium.onnx"
    }

}

